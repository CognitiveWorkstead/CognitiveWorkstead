<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>McKenzie Solar Status</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>

/* ===== BACKGROUND SCENE ===== */
body {
  margin:0;
  font-family: 'Segoe UI', sans-serif;
  color:#fff;

  background:
    linear-gradient(to bottom, rgba(20,40,20,.6), rgba(0,0,0,.85)),
    radial-gradient(circle at center, rgba(120,120,120,.15), transparent),
    linear-gradient(#1c2b1c,#050605);

}

/* vignette */
body:after {
  content:"";
  position:fixed;
  inset:0;
  background:
    radial-gradient(circle, transparent 60%, rgba(0,0,0,.7));
  pointer-events:none;
}

/* ===== GLOBAL ===== */
.container { padding:30px; }
.panel {
  background: rgba(0,0,0,.65);
  border-radius:14px;
  padding:16px;
  border:1px solid rgba(255,255,255,.08);
  backdrop-filter: blur(10px);
  box-shadow: 0 8px 30px rgba(0,0,0,.5);
}

.label {font-size:11px; opacity:.6; letter-spacing:1px;}
.big {font-size:32px; font-weight:600;}

/* HEADER */
.header {
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  margin-bottom:20px;
}
.title {
  font-size:60px;
  font-weight:800;
  letter-spacing:2px;
  color:#d8f5d2;
}
.subtitle {opacity:.75;}

.status {
  background:linear-gradient(160deg,#0f4d0f,#0a2c0a);
  padding:20px;
  border-radius:14px;
  text-align:center;
}
.status .big {color:#7CFF7C;}

.time {margin-top:5px; font-size:14px;}

/* NOW STRIP */
.now {
  display:flex;
  gap:12px;
  margin-bottom:20px;
}
.now .panel {flex:1; text-align:center;}

/* GRID */
.grid {
  display:grid;
  grid-template-columns: 1fr 2fr 1.4fr;
  gap:16px;
}

/* survivability spans */
.survive {
  grid-column: span 3;
}

/* progress */
.bar {
  height:10px;
  background:#333;
  border-radius:5px;
  overflow:hidden;
}
.fill {
  height:100%;
  background:linear-gradient(to right,#7CFF7C,#eaff57);
}

/* battery */
.battery {
  height:18px;
  border:2px solid #aaa;
}
.battery-fill {
  height:100%;
  background:linear-gradient(to right,red,yellow,lime);
}

/* gauge smaller */
.gauge {
  width:100%;
  height:100px;
}

.footer {
  margin-top:20px;
  text-align:center;
  opacity:.7;
}

@media(max-width:900px){
  .grid {grid-template-columns:1fr;}
  .survive {grid-column:span 1;}
  .now {flex-direction:column;}
}

</style>
</head>

<body>
<div class="container">

<!-- HEADER -->
<div class="header">
<div>
<div class="title">MCKENZIE SOLAR STATUS</div>
<div class="subtitle">REAL DATA. REAL TIME. OFF GRID.</div>
</div>

<div>
<div class="status">
<div>STATUS</div>
<div id="statusText" class="big"></div>
</div>
<div id="timestamp" class="time"></div>
</div>
</div>

<!-- NOW -->
<div class="now">

<div class="panel">
<div class="label">LOAD</div>
<div id="load" class="big"></div>
</div>

<div class="panel">
<div class="label">SOLAR</div>
<div id="solar" class="big"></div>
</div>

<div class="panel">
<div class="label">BATTERY</div>
<div id="battery" class="big"></div>
<div id="batteryPower"></div>
<div class="battery"><div id="batteryFill" class="battery-fill"></div></div>
</div>

<div class="panel">
<div class="label">MODE</div>
<div id="mode" class="big"></div>
</div>

<div class="panel">
<div class="label">TEMP</div>
<div id="tempNow" class="big"></div>
</div>

</div>

<!-- GRID -->
<div class="grid">

<div class="panel">
<div class="label">WEATHER</div>
<div id="temp"></div>
<div id="humidity"></div>
<div id="cloud"></div>
</div>

<div class="panel">
<div class="label">TODAY</div>
<div id="consumed"></div>
<div id="produced"></div>
<div id="avg"></div>
<div id="peakLoad"></div>
</div>

<div class="panel">
<div class="label">PERFORMANCE</div>

<svg viewBox="0 0 200 100" class="gauge">
<path d="M20,100 A80,80 0 0,1 180,100" stroke="#333" stroke-width="14" fill="none"/>
<path d="M20,100 A80,80 0 0,1 180,100" stroke="url(#grad)" stroke-width="14" fill="none"/>
<defs>
<linearGradient id="grad">
<stop offset="0%" stop-color="red"/>
<stop offset="50%" stop-color="yellow"/>
<stop offset="100%" stop-color="lime"/>
</linearGradient>
</defs>
<line id="needle" x1="100" y1="100" x2="100" y2="40" stroke="white" stroke-width="2"/>
</svg>

<div id="actual"></div>
<div id="similar"></div>

</div>

<div class="panel">
<div class="label">OCCUPANCY</div>
<div id="occState" class="big"></div>
<div id="occProb"></div>
</div>

<div class="panel survive">
<div class="label">SURVIVABILITY</div>

<div id="batteryKwh"></div>
<div class="battery"><div id="survBattery" class="battery-fill"></div></div>

<div>Zero solar</div>
<div class="bar"><div id="zeroBar" class="fill"></div></div>

<div>Similar</div>
<div class="bar"><div id="similarBar" class="fill"></div></div>

</div>

</div>

<div class="footer">
Sustainable Living • Hands-on Education • Community Resilience • Building a Better Tomorrow
</div>

</div>

<script>

function setGauge(val){
  let angle = (val/2000)*180;
  let rad = angle*Math.PI/180;
  let x=100+70*Math.cos(Math.PI-rad);
  let y=100-70*Math.sin(Math.PI-rad);
  let n=document.getElementById("needle");
  n.setAttribute("x2",x);
  n.setAttribute("y2",y);
}

async function loadData(){
  let r=await fetch("solarstatus.json?v="+Date.now());
  let d=await r.json();

  document.getElementById("statusText").innerText=d.status;
  document.getElementById("timestamp").innerText=new Date(d.timestamp).toLocaleString();

  document.getElementById("load").innerText=Math.round(d.now.load_w)+"W";
  document.getElementById("solar").innerText=Math.round(d.now.solar_w)+"W";

  document.getElementById("battery").innerText=d.now.battery_soc+"%";
  document.getElementById("batteryFill").style.width=d.now.battery_soc+"%";

  document.getElementById("mode").innerText=d.now.mode;
  document.getElementById("tempNow").innerText=d.weather.temperature_f+"°F";

  document.getElementById("temp").innerText=d.weather.temperature_f+"°F";
  document.getElementById("humidity").innerText=d.weather.humidity+"%";
  document.getElementById("cloud").innerText=d.weather.cloud_cover+"%";

  document.getElementById("consumed").innerText="Consumed "+d.today.consumed_kwh+" kWh";
  document.getElementById("produced").innerText="Produced "+d.today.produced_kwh+" kWh";
  document.getElementById("avg").innerText="Avg "+d.today.avg_load_w+"W";
  document.getElementById("peakLoad").innerText="Peak "+d.today.peak_load_w+"W";

  document.getElementById("batteryKwh").innerText="Battery "+d.survivability.usable_battery_kwh+"kWh";

  document.getElementById("zeroBar").style.width=Math.min(d.survivability.zero_solar_days*12,100)+"%";
  document.getElementById("similarBar").style.width=Math.min(d.survivability.similar_weather_days*3,100)+"%";

  document.getElementById("occState").innerText=d.occupancy.state;
  document.getElementById("occProb").innerText=d.occupancy.probability+"%";

  document.getElementById("actual").innerText="Actual "+d.performance.actual_solar_w+"W";
  document.getElementById("similar").innerText="Expected "+d.performance.similar_avg_solar_w+"W";

  setGauge(d.performance.actual_solar_w);
}

setInterval(loadData,60000);
loadData();

</script>

</body>
</html>
